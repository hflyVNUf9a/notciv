    {
        "name": "Phalanx",
        "replaces": "Spearman",
        "uniqueTo": "Hellas",
        "unitType": "Sword",
        "movement": 2,
        "strength": 11,
        "cost": 50,
        "requiredTech": "Bronze Working",
        "uniques": ["[+50]% Strength <vs [Mounted] units>"],
        "promotions": ["[Phalanx] ability"],
        "civilopediaText": [
            {
                "text": "Imagine the phalanx – a grid of men linked in tight formation, spears thrust into the faces of their foes. Morale was a key enemy for any army, and the phalanx offered individual hoplites few chances to break and run; the only way through a battle was forward. Hoplites appeared on the field around the eighth century BCE. They wore heavy bronze armor and carried a solid shield and a two-meter-long spear. The phalanx's opposing force was often a mass of sharpened bronze, armored against javelins that offered little room to slip in and use a blade. It would have been terrifying – on both sides. The phalanx moved in a straight, deliberate march. If the formation was flanked or skirmished, the hoplites lost most of their frightening power \nGreek hoplites were employed as mercenaries across the Mediterranean, Mesopotamia, and Near East. This style of fighting remained effective until later Roman innovations embraced a more nimble, disciplined system"
            },
            { "separator": true }
        ],
        "upgradesTo": "Pikeman",
        "obsoleteTech": "Civil Service",
        "hurryCostModifier": 20,
        "attackSound": "metalhit"
    },

    {
        "name": "Han Chu-Ko-Nu",
        "replaces": "Composite Bowman",
        "uniqueTo": "Han",
        "unitType": "Archery",
        "movement": 2,
        "strength": 12,
